{
    "id": "melodyctl",
    "name": "Melodyctl Buds",
    "description": "Battery, touch gestures and game mode for HeyMelody-family earbuds (verified on OPPO Enco Buds)",
    "category": "utilities",
    "version": "1.5.0",
    "author": "Chirag Verma",
    "license": "MIT",
    "icon": "earbuds",
    "type": "widget",
    "component": "./MelodyctlWidget.qml",
    "settings": "./MelodyctlSettings.qml",
    "capabilities": [
        "dankbar-widget",
        "control-center"
    ],
    "compositors": [
        "any"
    ],
    "distro": [
        "any"
    ],
    "dependencies": [
        "python3",
        "melodyctl"
    ],
    "permissions": [
        "process",
        "settings_read",
        "settings_write"
    ]
}
