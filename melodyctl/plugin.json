{
    "id": "melodyctl",
    "name": "Enco Buds Battery & Controls",
    "description": "Left / Right / Case battery plus game mode and touch-gesture controls for OPPO Enco Buds (ETI81), via the melodyctl CLI over the OPOv1/RFCOMM protocol.",
    "category": "utilities",
    "version": "1.0.2",
    "author": "chirag",
    "license": "MIT",
    "icon": "headset",
    "type": "widget",
    "component": "./MelodyctlWidget.qml",
    "settings": "./MelodyctlSettings.qml",
    "capabilities": [
        "dankbar-widget",
        "control-center"
    ],
    "compositors": [
        "any"
    ],
    "distro": [
        "any"
    ],
    "dependencies": [
        "python3",
        "melodyctl"
    ],
    "permissions": [
        "process",
        "settings_read",
        "settings_write"
    ]
}
